# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/copytrade

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# MetaApi account token (from your metaapi.cloud dashboard)
METAAPI_TOKEN=your-metaapi-token

# Port the API listens on
PORT=4000

# Comma-separated origins allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:5173
